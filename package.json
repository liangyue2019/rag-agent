{
  "name": "rag-agent",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"pnpm --filter web dev\" \"pnpm --filter server dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter server db:push",
    "eval": "pnpm --filter server eval"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
