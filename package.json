{
  "name": "rag-agent",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"corepack pnpm --filter web dev\" \"corepack pnpm --filter server dev\"",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm -r test",
    "db:push": "corepack pnpm --filter server db:push",
    "eval": "corepack pnpm --filter server eval"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
