# LLM 角色化配置：三角色各自独立（任意 OpenAI 兼容提供商均可）
# chat：对话与结构化输出（router/rewrite/grade/generate/chatReply/judge）
CHAT_MODEL=glm-4-flash
CHAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_API_KEY=

# embedding：入库与查询向量化（维度须与 Qdrant 集合一致，换模型需重建集合）
EMBEDDING_MODEL=embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# rerank：图内重排序节点打分
RERANK_MODEL=deepseek-chat
RERANK_BASE_URL=https://api.deepseek.com
RERANK_API_KEY=

QDRANT_URL=http://localhost:6333
DATABASE_URL=file:./data/app.db
PORT=3001
WEB_URL=http://localhost:3000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-agent
