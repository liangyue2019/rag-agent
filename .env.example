# LLM 角色化配置：三角色各自独立（任意 OpenAI 兼容提供商均可）
# chat：对话与结构化输出（router/rewrite/grade/generate/chatReply/judge）
#   示例为 DeepSeek-V4.1-Flash（model id = deepseek-flash）
CHAT_MODEL=deepseek-flash
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
# 透传到 chat 请求体的额外字段（JSON 对象，可留空）。
# DeepSeek-V4.1-Flash 默认开启思考模式，会拒绝结构化输出所需的强制 tool_choice，
# 故需关闭：{"thinking":{"type":"disabled"}}。换其他厂商时通常留空即可。
CHAT_EXTRA_BODY={"thinking":{"type":"disabled"}}

# embedding：入库与查询向量化（维度须与 Qdrant 集合一致，换模型需重建集合）
# 示例为本地 Ollama + qwen3-embedding:0.6b（1024 维，中文友好）。
# 注意：DeepSeek 无 embeddings 接口；Ollama 不校验 key，但本项目要求非空，随便填即可。
# 也可换成任意支持 embeddings 的厂商（智谱 embedding-3 / OpenAI / Qwen DashScope 等）。
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_DIM=1024

# rerank：图内重排序节点打分
RERANK_MODEL=deepseek-chat
RERANK_BASE_URL=https://api.deepseek.com
RERANK_API_KEY=

QDRANT_URL=http://localhost:6333
DATABASE_URL=file:./data/app.db
PORT=3001
WEB_URL=http://localhost:3000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-agent
